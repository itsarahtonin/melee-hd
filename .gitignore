/target
/.claude/
/.codex/

# Anything derived from a disc stays out of Git: images, extracted files,
# captured memory, and replay corpora. Keep local data under /local.
/local/
*.iso
*.gcm
*.rvz
*.ciso
*.gcz
*.wia
*.wbfs
*.nkit.*
*.dol
*.dat
*.usd
*.ssm
*.hps
*.thp
*.gci
*.raw
*.dump
*.slp
*.slpp
# The benchmark matches are replays made by the CPU AI in ssbm-rs, kept in the repository.
!/data/bench/*.slp

# The player built to play (`cargo run -p dist`).
/dist/
__pycache__/
